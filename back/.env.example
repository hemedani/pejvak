# Copy to `.env` and adjust. Deno does not auto-load `.env`; either export these
# in your shell or run with `deno run --env-file=.env ...`.
MONGO_URI=mongodb://127.0.0.1:27017/
DB_NAME=pejvak
APP_PORT=1405
ENV=development
TOKEN_KEY=pejvak_dev_secret_change_me

# Publishing a channel episode measures its loudness with `ffmpeg`, a runtime
# dependency (installed in the Docker image). Without it on the host, episodes
# still publish but carry an empty `waveform`, and clients fall back to their
# sample strip.
