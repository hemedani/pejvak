# Base URL of the Pejvak Lesan backend.
#
# Server-only on purpose — deliberately *not* prefixed with `NEXT_PUBLIC_`.
# Every backend call goes through a Server Action (D4), so this value has no
# business being inlined into a client bundle. A `NEXT_PUBLIC_` prefix would
# compile it into the browser JavaScript and make "no client fetch to the
# backend" a convention instead of a property of the build.
BACKEND_URL=http://localhost:1405
