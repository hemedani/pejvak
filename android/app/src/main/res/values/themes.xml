<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. Compose draws the real UI; this only styles the window/splash. -->
    <style name="Theme.Pejvak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Android 12+ splash (core-splashscreen backports to 29+). -->
    <style name="Theme.Pejvak.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_art</item>
        <item name="postSplashScreenTheme">@style/Theme.Pejvak</item>
    </style>
</resources>