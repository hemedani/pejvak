<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted for the esra source (mp3.esra.ir has no TLS listener)
     and the self-hosted Lesan backend. Everything else should prefer HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>